# a heading comment
# on two lines

x = 1  # what x is

# after two blank lines, which become one
fn f(a) {
    # inside the body
    a + 1
    # and at the bottom of it
}

xs = [
    1,  # one
    2,
]

# A comment inside a condition has no slot in the line it stands on: it is written where
# the layout allows and never dropped, which is the `leftovers` path.
while a && b {
    # why we keep going
    step()
}

f(
    1,
    # the last word, before the bracket closes
)
