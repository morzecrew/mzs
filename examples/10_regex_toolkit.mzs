# 10 — regular expressions: a literal type, two engines, one syntax.
#
#   mzs examples/10_regex_toolkit.mzs
#
# `/re/` is a literal, matching is the `~` operator (never `==`), and the engine is
# chosen for you: RE2 when the pattern is RE2-safe, a bundled backtracking engine when it
# uses `\b`, lookaround or a backreference. Both accept the same syntax and both are
# bounded, so a pathological pattern is a diagnostic and not a hung process.

# --- matching is an operator, and it answers a bool ---------------------------

println("matching")
["Привет!", "hello", "12345"].each { (s) ->
  println("  ${inspect(s).ljust(12)}~ /привет/i → ${s ~ /привет/i}   !~ /\\d/ → ${s !~ /\d/}")
}

# --- where, not just whether ---------------------------------------------------

s = "order A-1043 shipped, order B-77 pending"
println("")
println("in ${inspect(s)}")
println("  index(/[A-Z]-\\d+/)   ${s.index(/[A-Z]-\d+/)}          — a rune index")
println("  count(/order/)       ${s.count(/order/)}")
println("  matches(/[A-Z]-\\d+/) ${s.matches(/[A-Z]-\d+/).json}")

# --- captures: positional and named --------------------------------------------
#
# `captures` returns the whole match at 0 and the groups after it; named groups are
# reachable by name on the same array, which is what makes a parser readable.

line = "2026-03-05T14:30:59+03:00 WARN  booking  slot 12 already taken (retry 2/5)"
m = line.captures(/^(?<date>\d{4}-\d{2}-\d{2})T(?<time>[\d:]{8})\S*\s+(?<level>[A-Z]+)\s+(?<mod>\w+)\s+(?<msg>.+)$/)

println("")
println("one line, five fields")
println("  whole:  ${m[0].first(28)}…")
println("  date:   ${m["date"]}   time: ${m["time"]}")
println("  level:  ${m["level"]}   module: ${m["mod"]}")
println("  message ${inspect(m["msg"])}")
println("  by position: ${m[1]} / ${m[3]}")

# A failed match is nil, not an empty array — so `?.` and `??` do the work.
println("  no match → ${inspect("nothing here".captures(/(\d+)/))}, safe: ${"nothing here".captures(/(\d+)/)?.first ?? "(none)"}")

# --- every match, with its groups ---------------------------------------------

csv = "cut=1500, colour=3200, shave=600, beard=800"
# With groups, `matches` yields one array *of the groups* per match — the whole match is
# what `captures` puts at index 0, and here it would only be in the way.
pairs = csv.matches(/(\w+)=(\d+)/).map { (g) -> [g[0], g[1].int] }
println("")
println("matches with groups → ${pairs.dict.json}")
println("total ${pairs.sum { it[1] }} ₽")

# --- replacing: literal, backreference, or a closure over the match -----------

println("")
println("replacing")
println("  literal:   ${"a-b-c".replace("-", "+")}")
println("  first only ${"a-b-c".replace_first("-", "+")}")
println("  by group:  ${"2026-03-05".replace(/(\d+)-(\d+)-(\d+)/, '\3/\2/\1')}")
println("  by name:   ${"Ann Lee".replace(/(?<first>\w+) (?<last>\w+)/, '\k<last>, \k<first>')}")
println("  by closure:${" " + "price 1500, fee 300".replace(/\d+/) { (n) -> "${n.int * 2}" }}")
println("  redact:    ${"call +7 999 123-45-67 now".replace(/\d/, "•")}")

# --- splitting on a pattern ----------------------------------------------------

messy = "one,  two;three |four"
println("")
println("split on /[,;|]\\s*/ → ${messy.split(/[,;|]\s*/).map { it.trim }.json}")
println("split on whitespace → ${"  a   b  c ".split(" ").json}   — a run of spaces is one separator")

# --- flags ---------------------------------------------------------------------

println("")
println("flags")
println("  i (case)        ${"ПРИВЕТ" ~ /привет/i}")
println("  s (dot matches newline) ${"a\nb" ~ /a.b/s}")
println("  m (^ per line)  ${"x\nfoo" ~ /^foo$/m}")
println("  x (spacing)     ${"A-1043" ~ / [A-Z] - \d+ /x}   — /x ignores literal whitespace in the pattern")

# --- what only the backtracking engine can do ---------------------------------
#
# `\b` is Unicode-aware here: it sits between a letter and a non-letter in any script,
# which is exactly what a keyword search over Russian text needs.

text = "еда, а не еды; поедим — но не «беда»"
println("")
println("word boundaries in ${inspect(text)}")
println("  /\\bеда\\b/  → ${text ~ /\bеда\b/}   (matches the standalone word)")
println("  /\\bбеда\\b/ → ${text ~ /\bбеда\b/}   (inside «» it is still a word)")
println("  /\\bед\\b/   → ${text ~ /\bед\b/}   (a prefix is not a word)")

println("")
println("lookaround and backreferences")
println("  price without the currency: ${"1500 ₽".captures(/\d+(?= ₽)/)[0]}")
println("  not a test file:            ${"main.mzs" ~ /^(?!test_).*\.mzs$/}")
println("  doubled word:               ${"the the end".captures(/\b(\w+) \1\b/)?.dig(1) ?? "(none)"}")

# --- a regex is a value --------------------------------------------------------

re = /^\+?\d[\d\s()-]{6,}$/
println("")
println("a regex value: source ${inspect(re.source)}, flags ${inspect(re.flags)}")
println("  as a table:  ${["+7 999 123-45-67", "call me"].map { it ~ re }.json}")

# Built at runtime from a string — note the doubled backslash: this is a *string*, so
# `\d` would be a plain `d`. `mzs --check` warns about exactly this mistake.
digits = regex("^\\d+$")
println("  regex(\"^\\\\d+\$\") on \"42\": ${"42" ~ digits}")

# --- putting it together: a tiny tokenizer ------------------------------------

expr = "12 + 30*x - (7 / y)"
tokens = expr.matches(/\d+|[a-z]+|[-+*\/()]/).map { (t) ->
  kind = match t {
    /^\d+$/    -> "number"
    /^[a-z]+$/ -> "name"
    else       -> "operator"
  }
  {text: t, kind: kind}
}
println("")
println("tokenizing ${inspect(expr)}")
tokens.each_slice(6).each { (row) ->
  println("  ${row.map { "${it["text"]}:${it["kind"].first(3)}" }.join("  ")}")
}
println("  ${tokens.len} tokens, ${tokens.count { it["kind"] == "number" }} numbers, ${tokens.map { it["kind"] }.tally.json}")
