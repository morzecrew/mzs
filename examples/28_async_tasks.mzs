# 28 — async fn: tasks, await, and what "one evaluator at a time" buys you.
#
#   mzs examples/28_async_tasks.mzs
#   mzs --tasks 4 examples/28_async_tasks.mzs      # a tighter bound on live tasks
#
# Calling an `async fn` starts a task and hands it back; `t.await` is where the value
# appears. Tasks run on goroutines but never two at a time, so shared state needs no
# locks — what overlaps is waiting, which is exactly what a fan-out of slow calls needs.

# --- a task is a value ----------------------------------------------------------

async fn double(n) { n * 2 }

t = double(21)
say("type(t)  ${type(t)}")
say("t.done   ${t.done}      — the body has not run yet; nothing yielded to it")
say("t.await  ${t.await}")
say("t.done   ${t.done}")
say("again    ${t.await}      — a finished task keeps its answer")
say("str(t)   ${str(t)}")

# --- fan-out: start them all, then read them all ------------------------------

async fn work(id) {
  # A stand-in for something slow. In real code this would be http.get, and then the
  # waiting really would overlap.
  total = (1..2000).sum { it % (id + 2) }
  [id: id, total: total]
}

started = (1..6).map { (i) -> work(i) }
say("")
say("started ${started.len} tasks; ${started.count { it.done }} have finished so far")
results = started.map { it.await }
say("after awaiting: ${results.map { "#${it["id"]}=${it["total"]}" }.join(" ")}")

# --- errors surface at the await, and are catchable there ---------------------

async fn risky(n) {
  raise("task ${n} refuses to work") if n % 3 == 0
  "task ${n} ok"
}

say("")
say("errors")
(1..4).map { (n) -> [n: n, task: risky(n)] }.each { (row) ->
  outcome = try row["task"].await else (e) -> "caught: ${e["message"]}"
  say("  ${outcome}")
}

# --- a task that nobody awaits still runs -------------------------------------
#
# The Run does not end until its tasks do, so a fire-and-forget task is a use, not a
# leak. Its failure is reported on stderr rather than swallowed.

async fn notify(who) { say("  (notified ${who})"); "sent" }
notify("the manager")
say("")
say("fire and forget: the task started above has not run yet — it gets the interpreter")
say("at the next yield, so its line appears after this one, before the Run ends.")

# --- shared state is safe, because only one task evaluates at a time ---------

log = []
counter = [0]
async fn bump(id) {
  20.times { counter[0] += 1 }
  log.push(id)
  counter[0]
}

tasks = (1..8).map { (i) -> bump(i) }
finals = tasks.map { it.await }
say("")
say("eight tasks incremented one counter 20 times each")
say("  counter = ${counter[0]} (expected ${8 * 20}) — no lock, no atomic, no lost update")
say("  completion order: ${log.json}")
say("  the order is whatever the scheduler chose; the total never is")

# --- await inside a task, and a task that starts tasks -----------------------

async fn stage_one(n) { n + 1 }
async fn stage_two(n) { stage_one(n).await * 10 }
async fn pipeline(ns) { ns.map { (n) -> stage_two(n) }.map { it.await } }

say("")
say("nested tasks: ${pipeline([1, 2, 3]).await.json}")

# --- what the language refuses --------------------------------------------------

say("")
say("a task cannot await itself:")
async fn selfish() { $me.await }
$me = selfish()
say("  ${try $me.await else (e) -> e["message"]}")

# --- limits are shared, not per task -------------------------------------------
#
#   mzs --tasks 2 …    → 'too many tasks: 2 already running (MaxTasks)'
#   mzs --tasks 0 …    → 'tasks are disabled'
#   mzs -t 100ms …     → a task waiting for something that never comes still ends
#
# One Run, one step budget, one deadline, one context: a task cannot buy more time by
# being a task, and none of them outlives the Run that started them.

say("")
say("this Run started ${6 + 4 + 1 + 8 + 3 + 3 + 1} tasks in total and is about to join them all.")
