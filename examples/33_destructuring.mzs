# 33 — destructuring: one shape rule, three places to write it.
#
#   mzs examples/33_destructuring.mzs
#
# `a, b = pair` takes a value apart by position. The same shape in a `match` arm asks
# whether it fits instead of asserting that it does, and `for k, v in xs` is that rule
# with the pattern written in the loop header. Only an array or a range has positions;
# the lengths have to be equal, and a mismatch raises where it is written.

say("=== the assignment ===")

pair = [1, 2]
a, b = pair
say("a, b = pair            → a=${a} b=${b}")

[x, y] = pair
say("[x, y] = pair          → x=${x} y=${y}     (the brackets are optional)")

lo, hi = 1..2
say("lo, hi = 1..2          → lo=${lo} hi=${hi}   (a range has positions too)")

first, [second, third] = [1, [2, 3]]
say("[a, [b, c]] = …        → ${first} ${second} ${third}       (nesting is recursive)")

a, b = [b, a]
say("a, b = [b, a]          → a=${a} b=${b}     (a swap needs no temporary)")

seat = [row: 0, col: 0]
seat["row"], seat["col"], $sold = [12, 4, true]
say("a target is not only a name → ${seat.json}, \$sold=${$sold}")

# --- where it earns its keep: anything that already returns positions ----------

say("")
say("=== splitting, zipping, slicing ===")

user, host = "ivan@example.ru".split("@")
say("user@host              → user=${user} host=${host}")

name, price, qty = "гель;480;3".split(";")
say("a csv row              → ${name} × ${qty} по ${price} = ${price.int * qty.int}")

# `zip` hands back pairs, `partition` hands back exactly two arrays: both are shapes a
# pattern reads directly.
say("")
months = ["янв", "фев", "мар", "апр"]
sales = [120, 90, 160, 140]
months.zip(sales).each { (row) ->
  m, n = row
  say("  ${m}  ${"#" * (n / 20)} ${n}")
}

lows, highs = [120, 90, 160, 140].partition { it < 130 }
say("partition              → below ${lows.json}, above ${highs.json}")

say("")
say("=== for with two variables ===")

stock = [гель: 3, крем: 0, масло: 7]
for item, n in stock {
  say("  ${item.ljust(6)} ${n == 0 ? "нет в наличии" : "${n} шт"}")
}

# A dict iterates as [key, value] pairs, which is why the two-variable form reads the
# way it does. Anything else that yields pairs works the same.
total = 0
for sku, n in [["a", 2], ["b", 5]] { total += n }
say("  pairs of its own     → ${total}")

say("")
say("=== match: the same shape, asked as a question ===")

# A tiny stack calculator: the shape of the token decides the arm, and the arm binds
# what it needs. `[]` is a shape too, and a subject that fits no arm falls to `else`.
fn step(stack, tok) {
  match tok.split(" ") {
    ["push", n]  -> stack.push(n.int)
    ["add"]      -> (b, a = [stack.pop, stack.pop]; stack.push(a + b))
    ["mul"]      -> (b, a = [stack.pop, stack.pop]; stack.push(a * b))
    ["dup"]      -> stack.push(stack.last)
    []           -> stack
    else         -> raise("unknown token: ${tok}", kind: "user")
  }
}

program = ["push 2", "push 3", "add", "dup", "mul"]
say("${program.join(" | ")} → ${program.reduce([]) { (s, t) -> step(s, t) }.json}")

# A name binds, a literal still compares, and the guard sees what the pattern bound.
fn describe(v) {
  match v {
    [0, n]          -> "zero then ${n}"
    [m, n] if m > n -> "${m} > ${n}, descending"
    [m, n]          -> "${m}, ${n}"
    [only]          -> "just ${only}"
    []              -> "empty"
    else            -> "not a pair: ${inspect(v)}"
  }
}
[[0, 9], [5, 1], [1, 5], [7], [], "нет", [1, 2, 3]].each { (v) ->
  say("  ${inspect(v).ljust(11)} → ${describe(v)}")
}

say("")
say("=== a shape that does not fit ===")

# In an assignment the mismatch raises: the bug is here, not three lines further down.
say("  a, b = [1,2,3]  → " + try (a, b = [1, 2, 3]; "no error") else (e) -> "${e["kind"]}: ${e["message"]}")
say("  a, b = 1        → " + try (a, b = 1; "no error") else (e) -> "${e["kind"]}: ${e["message"]}")
say("  a, b = [x: 1]   → " + try (a, b = [x: 1, y: 2]; "no error") else (e) -> "${e["kind"]}: ${e["message"]}")

# In a `match` arm the very same mismatch is not an error — it is the next arm.
say("  match 1 { [a,b] -> … } → ${match 1 { [a, b] -> "fits"; else -> "moved on" }}")

say("")
say("A dict has no positions: key order is insertion order, not a contract. Take one")
say("apart by name — d[\"x\"], d[\"y\"] = … — or iterate it with for k, v in d.")
