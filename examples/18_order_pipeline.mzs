# 18 — an order pipeline: validate, price, partition, report.
#
#   mzs examples/18_order_pipeline.mzs
#
# Orders arrive in the shape the front end sent them, which is to say: not the shape you
# want. This is the whole path — reject what is broken, price what is left through a
# table of rules, and produce both the customer's receipt and the manager's summary.

PRICES = {haircut: 1500, beard: 800, colour: 3200, care: 600, shave: 700}
VAT = 20

orders = [
  {id: "A-1001", client: "Ivan Petrov",  promo: "",        items: [{sku: "haircut", qty: 2}, {sku: "beard", qty: 1}]},
  {id: "A-1002", client: "Anna Smith",   promo: "SPRING",  items: [{sku: "colour", qty: 1}, {sku: "care", qty: 2}]},
  {id: "A-1003", client: "Ivan Petrov",  promo: "",        items: []},
  {id: "A-1004", client: "",             promo: "",        items: [{sku: "shave", qty: 1}]},
  {id: "A-1005", client: "Li Ming",      promo: "VIP20",   items: [{sku: "haircut", qty: 1}, {sku: "colour", qty: 1}, {sku: "care", qty: 1}]},
  {id: "A-1006", client: "Sean O'Brien", promo: "",        items: [{sku: "massage", qty: 1}]},
  {id: "A-1007", client: "Anna Smith",   promo: "",        items: [{sku: "beard", qty: 3}]},
  {id: "A-1008", client: "Li Ming",      promo: "NOPE",    items: [{sku: "shave", qty: 2}, {sku: "care", qty: -1}]},
]

# --- validation: every problem, not just the first ---------------------------

fn problems(o) {
  found = []
  found.push("no client") if o["client"].blank
  found.push("empty order") if o["items"].empty
  o["items"].each { (i) ->
    found.push("unknown sku ${inspect(i["sku"])}") if !PRICES.has(i["sku"])
    found.push("bad quantity ${i["qty"]} for ${i["sku"]}") if i["qty"] <= 0
  }
  found.push("unknown promo ${inspect(o["promo"])}") if !o["promo"].blank && !["SPRING", "VIP20"].has(o["promo"])
  found
}

checked = orders.map { (o) -> o.merge({problems: problems(o)}) }
parts = checked.partition { it["problems"].empty }
good = parts[0]
bad = parts[1]

say("intake: ${orders.len} orders, ${good.len} accepted, ${bad.len} rejected")
bad.each { (o) -> say("  ✗ ${o["id"]}  ${o["problems"].join("; ")}") }

# --- pricing: a table of rules, applied in order ------------------------------
#
# Each rule is a name and a closure over the running total. Written as a list, the order
# of application is visible — which is the part that gets argued about in a meeting.

RULES = [
  {name: "volume 10%",  when: { (o, _) -> o["items"].sum { it["qty"] } >= 4 },
                        cut:  { (sub) -> sub * 10 / 100 }},
  {name: "SPRING 500",  when: { (o, sub) -> o["promo"] == "SPRING" && sub >= 3000 },
                        cut:  { (_) -> 500 }},
  {name: "VIP20",       when: { (o, _) -> o["promo"] == "VIP20" },
                        cut:  { (sub) -> sub * 20 / 100 }},
]

fn price(o) {
  lines = o["items"].map { (i) ->
    {sku: i["sku"], qty: i["qty"], unit: PRICES[i["sku"]], sum: i["qty"] * PRICES[i["sku"]]}
  }
  subtotal = lines.sum { it["sum"] }

  applied = []
  discount = RULES.filter { it["when"].call(o, subtotal) }.sum { (r) ->
    amount = r["cut"].call(subtotal)
    applied.push("${r["name"]} −${amount} ₽")
    amount
  }

  net = subtotal - discount
  vat = net * VAT / (100 + VAT)
  o.merge({lines: lines, subtotal: subtotal, discount: discount, applied: applied, total: net, vat: vat})
}

priced = good.map { (o) -> price(o) }

# --- the receipt ---------------------------------------------------------------

fn receipt(o) {
  out = ["┌─ ${o["id"]} ─ ${o["client"]}"]
  o["lines"].each { (l) ->
    out.push("│ ${l["sku"].ljust(10)}${l["qty"].str.rjust(2)} × ${l["unit"].str.rjust(4)} = ${(l["sum"].str + " ₽").rjust(8)}")
  }
  out.push("│ ${"subtotal".ljust(10)}${(o["subtotal"].str + " ₽").rjust(19)}")
  o["applied"].each { (a) -> out.push("│ ${a.rjust(29)}") }
  out.push("│ ${"total".ljust(10)}${(o["total"].str + " ₽").rjust(19)}")
  out.push("└ incl. VAT ${VAT}%: ${o["vat"]} ₽")
}

say("")
receipt(priced.find { it["id"] == "A-1005" }).each { (l) -> say(l) }

# --- the manager's numbers -----------------------------------------------------

say("")
say("${"order".ljust(8)}${"client".ljust(14)}${"items".rjust(6)}${"subtotal".rjust(10)}${"discount".rjust(10)}${"total".rjust(9)}")
say("-" * 57)
priced.sort_by { -it["total"] }.each { (o) ->
  say("${o["id"].ljust(8)}${o["client"].ljust(14)}${o["items"].sum { it["qty"] }.str.rjust(6)}${o["subtotal"].str.rjust(10)}${(o["discount"] == 0 ? "—" : "−" + o["discount"].str).rjust(10)}${o["total"].str.rjust(9)}")
}
say("-" * 57)
say("${"".ljust(22)}${priced.sum { (o) -> o["items"].sum { it["qty"] } }.str.rjust(6)}${priced.sum { it["subtotal"] }.str.rjust(10)}${("−" + priced.sum { it["discount"] }.str).rjust(10)}${priced.sum { it["total"] }.str.rjust(9)}")

# --- what sold, and to whom ----------------------------------------------------

say("")
say("by service")
priced.flat_map { it["lines"] }
      .group_by { it["sku"] }
      .map { (sku, ls) -> {sku: sku, qty: ls.sum { it["qty"] }, sum: ls.sum { it["sum"] }} }
      .sort_by { -it["sum"] }
      .each { (r) -> say("  ${r["sku"].ljust(10)}${r["qty"].str.rjust(3)} ×  ${(r["sum"].str + " ₽").rjust(9)}  ${"▇" * (r["sum"] / 500)}") }

say("")
say("by client")
priced.group_by { it["client"] }
      .map { (c, os) -> {client: c, orders: os.len, spent: os.sum { it["total"] }} }
      .sort_by { -it["spent"] }
      .each { (c) ->
        loyal = c["orders"] > 1 ? "  ★ repeat customer" : ""
        say("  ${c["client"].ljust(14)}${c["orders"].str.rjust(2)} order(s)  ${(c["spent"].str + " ₽").rjust(9)}${loyal}")
      }

# --- the one number the day is judged by --------------------------------------

say("")
say("accepted revenue ${priced.sum { it["total"] }} ₽ · average ticket ${priced.sum { it["total"] } / priced.len} ₽")
say("discounts given  ${priced.sum { it["discount"] }} ₽ (${priced.sum { it["discount"] } * 100 / priced.sum { it["subtotal"] }}% of subtotal)")
say("lost to rejects  ${bad.sum { (o) -> o["items"].filter { PRICES.has(it["sku"]) && it["qty"] > 0 }.sum { it["qty"] * PRICES[it["sku"]] } }} ₽ — fix the intake form, not the report")
