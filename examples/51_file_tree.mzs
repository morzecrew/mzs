# 51 — a directory tree: the path module, io.walk, and the half of io that changes things.
#
#   mzs examples/51_file_tree.mzs
#   mzs --read-only examples/51_file_tree.mzs     # refused before it runs, and says why
#
# `path` is pure: it takes names apart and puts them together, always with `/`, and never
# looks at a disk — so it needs nothing from the host (§12.20). io.walk lists a tree one
# directory at a time; io.mkdir, io.mv and io.rm change one. Those three exist only where
# the host both can do them and said yes (Options.FSMutations): the CLI says yes because
# the person typing already owns the machine, and --read-only is that person saying no.
#
# Everything below happens under $TMPDIR/mzs_example_51 and is removed again at the end.

include io
include path

# --- names, without a filesystem ----------------------------------------------

name = "reports/2026/q3.summary.csv"
println("path — names taken apart, lexically")
println("")
println("  path.dir(name)                        → ${path.dir(name)}")
println("  path.base(name)                       → ${path.base(name)}")
println("  path.stem(name) + path.ext(name)      → ${path.stem(name)} + ${path.ext(name)}")
println("  path.ext(\".gitignore\")                → ${inspect(path.ext(".gitignore"))}   (a leading dot hides, it does not type)")
println("  path.split(name)                      → ${path.split(name).json}")
println("  path.join(\"in\", \"../out\", \"x.json\")   → ${path.join("in", "../out", "x.json")}")
println("  path.clean(\"a//b/./c/..\")             → ${path.clean("a//b/./c/..")}")
println("  path.rel(name, \"reports\")             → ${path.rel(name, "reports")}")
println("  path.rel(\"/etc\", \"reports\")           → ${inspect(path.rel("/etc", "reports"))}   (no relative path says it)")
println("  path.match(\"**/*.csv\", name)          → ${path.match("**/*.csv", name)}")
println("  path.match(\"*.csv\", name)             → ${path.match("*.csv", name)}   (* stays inside one element)")

# --- a tree to work on ----------------------------------------------------------

root = path.join(io.env("TMPDIR", "/tmp"), "mzs_example_51")

# The names below are relative to root, which is what a reader wants to see; io.walk
# yields them with root in front, and a directory with a trailing `/`, which path.rel
# would clean away — so it is put back.
fn shown(p) {
  r = path.rel(p, root)
  p.ends_with("/") ? r + "/" : r
}

# A tree is removed deepest first, one name at a time: io.rm is not recursive, so the
# script says what it deletes. A run that failed halfway left its tree, and this clears it.
fn remove_tree(dir) {
  if !io.exists(dir) {
    return 0
  }
  n = 0
  for p in io.walk(dir).array.reverse {
    io.rm(p)
    n += 1
  }
  io.rm(dir)
  n + 1
}
remove_tree(root)

io.mkdir(path.join(root, "in/2025"))
io.mkdir(path.join(root, "in/2026"))
io.mkdir(path.join(root, "in/2026"))           # already there: that is what was asked for
io.write(path.join(root, "in/2025/q4.csv"), "region,total\nnorth,120\n")
io.write(path.join(root, "in/2026/q1.csv"), "region,total\nnorth,90\nsouth,40\n")
io.write(path.join(root, "in/2026/notes.txt"), "draft\n")
io.write(path.join(root, ".gitignore"), "out/\n")

println("")
println("io.walk — depth-first, each directory sorted, directories with a /")
println("")
io.walk(root).each { println("  ${shown(it)}") }

# --- a glob is a walk and a match ------------------------------------------------

csvs = io.walk(root).filter { path.match("**/*.csv", it) }.array
bytes = csvs.map { io.stat(it)["size"] }.sum
println("")
println("  **/*.csv                → ${csvs.map { shown(it) }.json}")
println("  their size              → ${bytes} bytes")
println("  io.stat(in/2025/q4.csv) → ${io.stat(path.join(root, "out/../in/2025/q4.csv")).json}")
println("  io.stat(in/2026)[\"dir\"] → ${io.stat(path.join(root, "in/2026"))["dir"]}")
println("  io.stat(nothing)        → ${inspect(io.stat(path.join(root, "nothing")))}")

# --- changing it --------------------------------------------------------------------

io.mkdir(path.join(root, "out"))
for p in csvs {
  io.mv(p, path.join(root, "out", path.stem(p) + "_" + path.base(path.dir(p)) + ".csv"))
}
println("")
println("io.mv — the CSVs collected into out/, named by their year")
println("")
println("  out/                    → ${io.ls(path.join(root, "out")).json}")
println("  in/2026/                → ${io.ls(path.join(root, "in/2026")).json}")

println("")
println("io.rm — one name at a time")
println("")
notes = path.join(root, "in/2026/notes.txt")
println("  rm notes.txt            → ${io.rm(notes)}")
println("  rm notes.txt again      → ${io.rm(notes)}   (it was not there: false, not an error)")
println("  rm in/ with things in   → ${try io.rm(path.join(root, "in")) else (e) -> e["kind"]}   (not recursive)")
println("  the whole tree          → ${remove_tree(root)} names removed")
println("  root exists             → ${io.exists(root)}")
