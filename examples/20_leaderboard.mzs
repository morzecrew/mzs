# 20 — a leaderboard, and the four honest ways to rank a tie.
#
#   mzs examples/20_leaderboard.mzs
#
# Ranking looks like `sort_by` and one index, until two players score the same. This file
# implements competition ranking (1224), dense ranking (1223) and ordinal ranking (1234),
# tracks movement between rounds, and computes the percentile that decides the cut.

rounds = [
  [ann: 120, bob: 95,  cleo: 120, dmi: 60,  eve: 80,  fred: 95],
  [ann: 140, bob: 130, cleo: 100, dmi: 90,  eve: 80,  fred: 145],
  [ann: 160, bob: 150, cleo: 155, dmi: 150, eve: 110, fred: 120],
]

PLAYERS = rounds.first.keys

# --- totals, then the three rankings ------------------------------------------

totals = PLAYERS.map { (p) -> [name: p, score: rounds.sum { (r) -> r[p] }] }.sort_by { -it["score"] }

fn rank_competition(sorted) {
  seen = 0
  last_score = nil
  last_rank = 0
  sorted.map { (row) ->
    seen += 1
    rank = row["score"] == last_score ? last_rank : seen
    last_score = row["score"]
    last_rank = rank
    row.merge([rank: rank])
  }
}

fn rank_dense(sorted) {
  rank = 0
  last_score = nil
  sorted.map { (row) ->
    rank += 1 if row["score"] != last_score
    last_score = row["score"]
    row.merge([dense: rank])
  }
}

ranked = rank_dense(rank_competition(totals))

say("final standings after ${rounds.len} rounds")
say("${"#".rjust(3)}${"dense".rjust(7)}  ${"player".ljust(8)}${"score".rjust(7)}  bar")
say("-" * 46)
best = ranked.first["score"]
ranked.each { (r) ->
  medal = match r["rank"] { 1 -> " 🥇"; 2 -> " 🥈"; 3 -> " 🥉"; else -> "" }
  say("${r["rank"].str.rjust(3)}${r["dense"].str.rjust(7)}  ${r["name"].ljust(8)}${r["score"].str.rjust(7)}  ${"█" * (r["score"] * 24 / best)}${medal}")
}
say("ordinal (1234) order: ${ranked.map { it["name"] }.join(" > ")}")

# --- per-round table, and the movement between them ---------------------------

fn standing_of(round) {
  round.sort_by { (_, v) -> -v }.map { it[0] }
}

say("")
say("${"round".ljust(8)}${PLAYERS.map { it.ljust(7) }.join("")}")
rounds.each_with_index { (r, i) ->
  say("${("R" + (i + 1).str).ljust(8)}${PLAYERS.map { r[it].str.ljust(7) }.join("")}")
}

say("")
say("movement in the last round")
prev = standing_of(rounds[rounds.len - 2])
now = standing_of(rounds.last)
now.each_with_index { (p, i) ->
  was = prev.index(p)
  delta = was - i
  arrow = match {
    delta > 0 -> "▲ ${delta}"
    delta < 0 -> "▼ ${-delta}"
    else      -> "="
  }
  say("  ${(i + 1).str.rjust(2)}. ${p.ljust(8)}${arrow.ljust(6)}(was ${was + 1})")
}

# --- statistics: mean, median, spread, percentile -----------------------------

scores = totals.map { it["score"] }.sort
fn median(xs) { xs.len % 2 == 1 ? xs[xs.len / 2] : (xs[xs.len / 2 - 1] + xs[xs.len / 2]) / 2 }
fn percentile_of(xs, v) { xs.count { it < v } * 100 / xs.len }

say("")
say("mean ${scores.sum / scores.len} · median ${median(scores)} · spread ${scores.last - scores.first}")
say("percentile of each player:")
ranked.each { (r) -> say("  ${r["name"].ljust(8)}${percentile_of(scores, r["score"]).str.rjust(3)}th") }

cut = median(scores)
say("")
say("cut at the median (${cut}): ${ranked.filter { it["score"] >= cut }.map { it["name"] }.join(", ")} advance")

# --- streaks: who improved every round ----------------------------------------

say("")
say("consistency")
PLAYERS.each { (p) ->
  series = rounds.map { (r) -> r[p] }
  deltas = series.each_cons(2).map { (pair) -> pair[1] - pair[0] }
  trend = match {
    deltas.all { it > 0 }  -> "improving every round"
    deltas.all { it >= 0 } -> "never went down"
    deltas.all { it < 0 }  -> "falling"
    else                   -> "up and down"
  }
  say("  ${p.ljust(8)}${series.join(" → ").ljust(20)}${("%+d" % (series.last - series.first)).rjust(5)}  ${trend}")
}

# --- head to head ---------------------------------------------------------------

say("")
say("head to head, by rounds won")
pairs = PLAYERS.flat_map { (a) -> PLAYERS.filter { it > a }.map { (b) -> [a, b] } }
pairs.each { (pair) ->
  a = pair[0]
  b = pair[1]
  wins_a = rounds.count { (r) -> r[a] > r[b] }
  wins_b = rounds.count { (r) -> r[b] > r[a] }
  draws = rounds.len - wins_a - wins_b
  say("  ${a.ljust(6)}${wins_a}–${wins_b}${draws > 0 ? " (${draws} tied)" : ""}  ${b}")
}

# --- the one line a chat bot would post ---------------------------------------

top = ranked.first
say("")
say("🏆 ${top["name"].capitalize} wins with ${top["score"]}, ${top["score"] - ranked[1]["score"]} clear of ${ranked[1]["name"].capitalize}.")
say("   ${ranked.filter { it["rank"] == 1 }.len > 1 ? "It is a shared first place." : "No tie at the top."}")
