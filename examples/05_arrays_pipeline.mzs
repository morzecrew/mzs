# 05 — arrays: one dataset, twelve questions, no loops.
#
#   mzs examples/05_arrays_pipeline.mzs
#
# A month of transactions goes in; a sales report comes out. Every answer below is a
# chain of the §12.3 rows — map, filter, reduce, group_by, partition, sort_by, take,
# zip, flat_map, each_cons, tally — because a pipeline reads in the order it happens,
# while a loop makes the reader hold the state in their head.

tx = [
  {day: 1,  rep: "ann",  region: "north", item: "haircut",  qty: 3, price: 1500},
  {day: 1,  rep: "bob",  region: "south", item: "beard",    qty: 2, price: 800},
  {day: 3,  rep: "ann",  region: "north", item: "colour",   qty: 1, price: 3200},
  {day: 4,  rep: "cleo", region: "east",  item: "haircut",  qty: 5, price: 1500},
  {day: 6,  rep: "bob",  region: "south", item: "haircut",  qty: 2, price: 1500},
  {day: 7,  rep: "ann",  region: "north", item: "beard",    qty: 4, price: 800},
  {day: 9,  rep: "cleo", region: "east",  item: "colour",   qty: 2, price: 3200},
  {day: 11, rep: "dmi",  region: "north", item: "shave",    qty: 6, price: 600},
  {day: 12, rep: "bob",  region: "south", item: "colour",   qty: 1, price: 3200},
  {day: 15, rep: "ann",  region: "north", item: "haircut",  qty: 2, price: 1500},
  {day: 18, rep: "cleo", region: "east",  item: "shave",    qty: 3, price: 600},
  {day: 21, rep: "dmi",  region: "north", item: "beard",    qty: 1, price: 800},
  {day: 24, rep: "ann",  region: "north", item: "colour",   qty: 3, price: 3200},
  {day: 27, rep: "bob",  region: "south", item: "shave",    qty: 4, price: 600},
  {day: 28, rep: "cleo", region: "east",  item: "haircut",  qty: 1, price: 1500},
]

fn total(t) { t["qty"] * t["price"] }
fn money(n) { "${n} ₽".rjust(9) }

# --- the shape of the data ----------------------------------------------------

println("${tx.len} transactions, days ${tx.first["day"]}–${tx.last["day"]}")
println("revenue ${money(tx.sum { total(it) })}, units ${tx.sum { it["qty"] }}")
println("average ticket ${money(tx.sum { total(it) } / tx.len)}")
println("largest single sale: ${money(tx.max_by { total(it) }.pipe { total(it) })} by ${tx.max_by { total(it) }["rep"]}")

# --- group_by builds a dict of arrays; sort_by ranks it ------------------------

println("")
println("by region")
tx.group_by { it["region"] }.sort_by { (_, rows) -> -rows.sum { total(it) } }.each { (pair) ->
  region = pair[0]
  rows = pair[1]
  share = rows.sum { total(it) } * 100 / tx.sum { total(it) }
  println("  ${region.ljust(7)}${money(rows.sum { total(it) })}  ${share}%  ${"▉" * (share / 4)}")
}

# --- a leaderboard is sort_by + take + each_with_index -------------------------

println("")
println("top reps")
tx.group_by { it["rep"] }
  .map { (rep, rows) -> {rep: rep, sales: rows.len, revenue: rows.sum { total(it) }} }
  .sort_by { -it["revenue"] }
  .take(3)
  .each_with_index { (r, i) ->
    println("  ${i + 1}. ${r["rep"].ljust(6)}${money(r["revenue"])} over ${r["sales"]} sales")
  }

# --- partition splits once, into both halves ----------------------------------

parts = tx.partition { total(it) >= 3000 }
big = parts[0]
small = parts[1]
println("")
println("big tickets (≥ 3000 ₽): ${big.len}, everything else: ${small.len}")
println("  big:   ${big.map { it["item"] }.uniq.join(", ")}")
println("  small: ${small.map { it["item"] }.uniq.join(", ")}")

# --- reduce when the accumulator is not a number -------------------------------

units = tx.reduce({}) { (acc, t) -> acc.set(t["item"], (acc[t["item"]] ?? 0) + t["qty"]) }
println("")
println("units per item: ${units.sort_by { (_, n) -> -n }.map { "${it[0]} ${it[1]}" }.join(", ")}")

# --- each_cons for anything that compares neighbours ---------------------------

daily = tx.group_by { it["day"] }.map { (day, rows) -> {day: day, sum: rows.sum { total(it) }} }
gaps = daily.each_cons(2).map { (pair) -> pair[1]["day"] - pair[0]["day"] }
println("")
println("selling days: ${daily.len}, longest gap between them: ${gaps.max} days")

streak = 0
best = 0
daily.each_cons(2).each { (pair) ->
  streak = pair[1]["sum"] > pair[0]["sum"] ? streak + 1 : 0
  best = streak if streak > best
}
println("longest run of growing days: ${best}")

# --- flat_map, zip and each_slice ---------------------------------------------

lines = tx.take(3).flat_map { (t) -> [t["item"], "  qty ${t["qty"]} × ${t["price"]} ₽"] }
println("")
println("receipt for the first three:")
lines.each { (l) -> println("  ${l}") }

labels = ["north", "south", "east"]
totals = labels.map { (r) -> tx.filter { it["region"] == r }.sum { total(it) } }
println("")
println("zip: ${labels.zip(totals).map { "${it[0]}=${it[1]}" }.join(" ")}")

println("weeks: ${(1..28).array.each_slice(7).map { "${it.first}–${it.last}" }.join(" | ")}")

# --- the predicates ------------------------------------------------------------

println("")
println("all sales are positive:      ${tx.all { total(it) > 0 }}")
println("any sale over 10 000 ₽:      ${tx.any { total(it) > 10000 }}")
println("no sale is free:             ${tx.none { total(it) == 0 }}")
println("colour sales:                ${tx.count { it["item"] == "colour" }}")
println("first north sale after day 5: day ${tx.find { it["region"] == "north" && it["day"] > 5 }["day"]}")
println("item names, sorted:          ${tx.map { it["item"] }.uniq.sort.json}")
println("busiest day:                 ${tx.map { it["day"] }.tally.sort_by { (_, n) -> -n }.first[0]}")

# --- mutation is explicit, and named so at the call site -----------------------

queue = [3, 1, 2]
queue.push(4).unshift(0)
println("")
println("queue after push/unshift: ${queue.json}, shift → ${queue.shift}, pop → ${queue.pop}")
println("sort returns a copy: ${[3, 1, 2].sort.json}; sort_in_place mutates the receiver")
