# 09 — $variables: the values the host puts in, and the ones the script hands back.
#
#   mzs examples/09_host_variables.mzs
#   mzs -v '__sent=  OPERATOR ' -v price=1500 examples/09_host_variables.mzs
#   mzs --vars '{"__sent":"yes","price":1500,"tags":["vip","new"]}' examples/09_host_variables.mzs
#
# A `$name` is not a local: it lives in a table the host owns, it is a namespace of its
# own, and it is never resolved through the scope chain. An unbound one reads as nil
# instead of failing, because a dialogue condition must survive a variable that was
# never set — that is the whole reason the form exists.

# --- reading: unbound is nil, and nil has two operators ------------------------

sent    = $__sent ?? ""
price   = $price ?? "0"
tags    = $tags ?? []
name    = $client_name ?? "guest"

println("what the host passed in")
println("  \$__sent      ${inspect($__sent)}")
println("  \$price       ${inspect($price)}")
println("  \$tags        ${inspect($tags)}")
println("  \$missing     ${inspect($nothing_here)}      — unbound reads as nil, never an error")
println("  defined()    __sent=${defined($__sent)} nothing_here=${defined($nothing_here)}")

# `defined` asks the table, not the value: a $var explicitly set to nil is still bound.
println("  a bound nil is still defined once the host sets it")

# --- host values arrive as strings; conversion is explicit and never raises ----
#
# With `-v` every value is a string. With `--vars` (JSON) an int stays an int. Code that
# works under both is code that converts what it needs, when it needs it.

println("")
println("conversions")
println("  price + 1200      ${price.int + 1200}      — .int of \"\" is 0, of \"12abc\" is 12")
println("  is it a number?   ${price.str ~ /^\d+(\.\d+)?$/}")
println("  as float          ${price.float}")
println("  blank check       ${sent.str.blank}")
println("  normalised        ${inspect(sent.str.lower.trim)}")

# --- interpolation reaches $vars directly --------------------------------------

println("")
println("interpolation")
println("  Hello, $client_name!  →  Hello, ${name}!")
println("  \${\$price} inside text →  the price is ${$price ?? "unset"}")

# --- the classic: a stored dialogue condition ---------------------------------
#
# These are the shapes a bot engine stores as strings and evaluates per message. Each is
# a complete program whose value is a bool — which is what `mzs --bool` exits on.

s = sent.str.lower.trim

conditions = [
  {name: "confirm",     value: s == "yes" || s ~ /^(yeah|sure|ok|y)$/},
  {name: "handoff",     value: s ~ /operator|real person|manager|support/},
  {name: "menu",        value: s ~ /all topics|main menu|\bmenu\b|show everything/},
  {name: "cancel",      value: s ~ /^(cancel|stop|abort)$/ || s.starts_with("❌")},
  {name: "big spender", value: price.int >= 1000},
  {name: "is vip",      value: is(tags, "array") && tags.has("vip")},
  {name: "not empty",   value: !s.blank},
]

println("")
println("stored conditions against ${inspect(sent)}")
conditions.each { (c) ->
  println("  ${(c["value"] ? "✓" : "·")} ${c["name"].ljust(14)}${c["value"]}")
}

intent = match {
  conditions.find { it["name"] == "cancel" }["value"]  -> "cancel"
  conditions.find { it["name"] == "handoff" }["value"] -> "handoff_operator"
  conditions.find { it["name"] == "menu" }["value"]    -> "main_menu"
  conditions.find { it["name"] == "confirm" }["value"] -> "confirm"
  s.blank                                              -> "empty"
  else                                                 -> "unknown"
}

# --- writing: a $var assigned here is what the host reads back ----------------
#
# In Go that is Result.Globals; from the CLI it is state that later lines can see. This
# is how a "set variable" block in a flow editor is expressed.

$intent = intent
$normalized = s
$attempts = ($attempts ?? "0").int + 1
$score = (price.int / 100) + (intent == "confirm" ? 10 : 0)

println("")
println("what the script hands back")
println("  \$intent      ${$intent}")
println("  \$normalized  ${inspect($normalized)}")
println("  \$attempts    ${$attempts}")
println("  \$score       ${$score}")

# --- the answer, as a bot engine would take it --------------------------------

reply = match $intent {
  "confirm"          -> "Great, booking you in${name == "guest" ? "" : ", ${name}"}."
  "handoff_operator" -> "Putting you through to an operator…"
  "main_menu"        -> "Here is the main menu."
  "cancel"           -> "Cancelled."
  "empty"            -> "Write something and I will help."
  else               -> "I did not get that. Try «menu»."
}

println("")
println("reply: ${reply}")
println("payload: ${{intent: $intent, score: $score, vip: is(tags, "array") && tags.has("vip")}.json}")

# The value of the whole program is its last expression — `mzs --bool` turns that into
# an exit code, which is how a condition becomes a branch in the flow engine.
intent == "confirm"
