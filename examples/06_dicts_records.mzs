# 06 — dicts: records, indexes and configuration, in insertion order.
#
#   mzs examples/06_dicts_records.mzs
#
# A dict is the record type, the index type and the config type, and it keeps the order
# you built it in — so a report, a JSON body and a `keys` listing all come out in the
# order the program wrote them, not in the order a hash function decided.

staff = [
  [id: 1, name: "Ann",  dept: "cutting", grade: 3, since: 2019, skills: ["haircut", "colour"]],
  [id: 2, name: "Bob",  dept: "cutting", grade: 2, since: 2022, skills: ["haircut"]],
  [id: 3, name: "Cleo", dept: "colour",  grade: 4, since: 2017, skills: ["colour", "care"]],
  [id: 4, name: "Dmi",  dept: "barber",  grade: 1, since: 2025, skills: ["shave", "beard"]],
  [id: 5, name: "Eve",  dept: "colour",  grade: 3, since: 2021, skills: ["colour"]],
]

# --- a record is a dict, and reading it has four spellings for four intents ----

ann = staff.first
say("record: ${ann.json}")
say("  [\"name\"]        ${ann["name"]}          — nil when absent")
say("  get(\"phone\")    ${inspect(ann.get("phone"))}         — same, with a default available")
say("  get(\"phone\", \"—\") ${ann.get("phone", "—")}")
say("  fetch(\"name\")   ${ann.fetch("name")}          — raises when absent, for the ones that must be there")
say("  dig(\"skills\", 0) ${ann.dig("skills", 0)}       — nil-safe through arrays and dicts both")
say("  has(\"grade\")    ${ann.has("grade")}         — key test, never a value test")
say("  keys            ${ann.keys.json}")

# --- an index: build one dict out of many records -----------------------------

by_id = staff.reduce([:]) { (acc, p) -> acc.set(p["id"], p) }
say("")
say("index by id → ${by_id[3]["name"]} (${by_id.len} entries, int keys)")

by_dept = staff.group_by { it["dept"] }
say("index by dept → ${by_dept.keys.json}")
by_dept.each { (dept, people) ->
  say("  ${dept.ljust(9)}${people.map { it["name"] }.join(", ")}")
}

# A dict of arrays inverts into a lookup the other way round.
who_can = [:]
staff.each { (p) ->
  p["skills"].each { (s) -> who_can[s] = (who_can[s] ?? []).push(p["name"]) }
}
say("index by skill → ${who_can.map { (skill, names) -> "${skill}: ${names.join("/")}" }.join(", ")}")

# --- filter, reject, map: a dict in, a dict (or an array) out ------------------

senior = by_id.filter { (_, p) -> p["grade"] >= 3 }
say("")
say("seniors: ${senior.values.map { it["name"] }.join(", ")}")
say("juniors: ${by_id.reject { (_, p) -> p["grade"] >= 3 }.values.map { it["name"] }.join(", ")}")
say("names by seniority: ${staff.sort_by { it["since"] }.map { "${it["name"]}(${it["since"]})" }.join(" ")}")

grades = staff.reduce([:]) { (acc, p) -> acc.set(p["name"], p["grade"]) }
say("grade table: ${grades.json}")
say("  invert:     ${grades.invert.json}     — last writer wins on a collision")
say("  has_val(4): ${grades.has_val(4)}")
say("  find:       ${grades.find { (_, g) -> g == 4 }.json}")
say("  all ≥ 1:    ${grades.all { (_, g) -> g >= 1 }}")

# --- configuration: merge, and the deep merge you have to write yourself -------
#
# `merge` is one level deep on purpose — a language that guesses how deep to go is a
# language that surprises you. Six lines of recursion is the version that never does.

defaults = [
  service: "booking",
  http:    [host: "0.0.0.0", port: 8080, tls: [enabled: false, cert: ""]],
  limits:  [timeout_ms: 1000, retries: 2],
  tags:    ["default"],
]

override = [
  http:   [port: 443, tls: [enabled: true, cert: "/etc/ssl/site.pem"]],
  limits: [retries: 5],
  tags:   ["prod", "eu"],
]

fn deep_merge(a, b) {
  out = dup(a)
  b.each { (k, v) ->
    out.set(k, is(out[k], "dict") && is(v, "dict") ? deep_merge(out[k], v) : v)
  }
  out
}

say("")
say("shallow merge loses the nested keys:")
say("  ${defaults.merge(override)["http"].json}")
say("deep merge keeps them:")
config = deep_merge(defaults, override)
say("  ${config["http"].json}")
say("  ${config["limits"].json}, tags ${config["tags"].json}")

# --- reading a config safely: dig plus ?? is the whole idiom -------------------

say("")
say("cert:      ${config.dig("http", "tls", "cert") ?? "(none)"}")
say("missing:   ${config.dig("http", "proxy", "url") ?? "(none)"}")
say("timeout:   ${config.dig("limits", "timeout_ms") ?? 500} ms")

# --- mutation, and the copy that keeps the original intact --------------------

draft = dup(config)
draft["service"] = "booking-canary"
draft.set("owner", "platform").delete("tags")
say("")
say("draft keys:  ${draft.keys.json}")
say("config keys: ${config.keys.json}   — dup kept the original whole (one level deep)")

# --- keys are values, not names ------------------------------------------------

mixed = [:]
mixed[1] = "int key"
mixed[true] = "bool key"
mixed["1"] = "string key — a different key"
mixed[nil] = "nil key"
say("")
say("mixed keys: ${mixed.len} entries, [1] is ${inspect(mixed[1])}, [\"1\"] is ${inspect(mixed["1"])}")

# --- counting is a dict, and so is a histogram ---------------------------------

say("")
say("headcount by dept: ${staff.map { it["dept"] }.tally.json}")
say("skills in use:     ${staff.flat_map { it["skills"] }.tally.sort_by { (_, n) -> -n }.map { "${it[0]}×${it[1]}" }.join(" ")}")
