# 06 — dicts: records, indexes and configuration, in insertion order.
#
#   mzs examples/06_dicts_records.mzs
#
# A dict is the record type, the index type and the config type, and it keeps the order
# you built it in — so a report, a JSON body and a `keys` listing all come out in the
# order the program wrote them, not in the order a hash function decided.

staff = [
  {id: 1, name: "Ann",  dept: "cutting", grade: 3, since: 2019, skills: ["haircut", "colour"]},
  {id: 2, name: "Bob",  dept: "cutting", grade: 2, since: 2022, skills: ["haircut"]},
  {id: 3, name: "Cleo", dept: "colour",  grade: 4, since: 2017, skills: ["colour", "care"]},
  {id: 4, name: "Dmi",  dept: "barber",  grade: 1, since: 2025, skills: ["shave", "beard"]},
  {id: 5, name: "Eve",  dept: "colour",  grade: 3, since: 2021, skills: ["colour"]},
]

# --- a record is a dict, and reading it has four spellings for four intents ----

ann = staff.first
println("record: ${ann.json}")
println("  [\"name\"]        ${ann["name"]}          — nil when absent")
println("  get(\"phone\")    ${inspect(ann.get("phone"))}         — same, with a default available")
println("  get(\"phone\", \"—\") ${ann.get("phone", "—")}")
println("  fetch(\"name\")   ${ann.fetch("name")}          — raises when absent, for the ones that must be there")
println("  dig(\"skills\", 0) ${ann.dig("skills", 0)}       — nil-safe through arrays and dicts both")
println("  has(\"grade\")    ${ann.has("grade")}         — key test, never a value test")
println("  keys            ${ann.keys.json}")

# --- an index: build one dict out of many records -----------------------------

by_id = staff.reduce({}) { (acc, p) -> acc.set(p["id"], p) }
println("")
println("index by id → ${by_id[3]["name"]} (${by_id.len} entries, int keys)")

by_dept = staff.group_by { it["dept"] }
println("index by dept → ${by_dept.keys.json}")
by_dept.each { (dept, people) ->
  println("  ${dept.ljust(9)}${people.map { it["name"] }.join(", ")}")
}

# A dict of arrays inverts into a lookup the other way round.
who_can = {}
staff.each { (p) ->
  p["skills"].each { (s) -> who_can[s] = (who_can[s] ?? []).push(p["name"]) }
}
println("index by skill → ${who_can.map { (skill, names) -> "${skill}: ${names.join("/")}" }.join(", ")}")

# --- filter, reject, map: a dict in, a dict (or an array) out ------------------

senior = by_id.filter { (_, p) -> p["grade"] >= 3 }
println("")
println("seniors: ${senior.values.map { it["name"] }.join(", ")}")
println("juniors: ${by_id.reject { (_, p) -> p["grade"] >= 3 }.values.map { it["name"] }.join(", ")}")
println("names by seniority: ${staff.sort_by { it["since"] }.map { "${it["name"]}(${it["since"]})" }.join(" ")}")

grades = staff.reduce({}) { (acc, p) -> acc.set(p["name"], p["grade"]) }
println("grade table: ${grades.json}")
println("  invert:     ${grades.invert.json}     — last writer wins on a collision")
println("  has_val(4): ${grades.has_val(4)}")
println("  find:       ${grades.find { (_, g) -> g == 4 }.json}")
println("  all ≥ 1:    ${grades.all { (_, g) -> g >= 1 }}")

# --- configuration: merge, and the deep merge you have to write yourself -------
#
# `merge` is one level deep on purpose — a language that guesses how deep to go is a
# language that surprises you. Six lines of recursion is the version that never does.

defaults = {
  service: "booking",
  http:    {host: "0.0.0.0", port: 8080, tls: {enabled: false, cert: ""}},
  limits:  {timeout_ms: 1000, retries: 2},
  tags:    ["default"],
}

override = {
  http:   {port: 443, tls: {enabled: true, cert: "/etc/ssl/site.pem"}},
  limits: {retries: 5},
  tags:   ["prod", "eu"],
}

fn deep_merge(a, b) {
  out = dup(a)
  b.each { (k, v) ->
    out.set(k, is(out[k], "dict") && is(v, "dict") ? deep_merge(out[k], v) : v)
  }
  out
}

println("")
println("shallow merge loses the nested keys:")
println("  ${defaults.merge(override)["http"].json}")
println("deep merge keeps them:")
config = deep_merge(defaults, override)
println("  ${config["http"].json}")
println("  ${config["limits"].json}, tags ${config["tags"].json}")

# --- reading a config safely: dig plus ?? is the whole idiom -------------------

println("")
println("cert:      ${config.dig("http", "tls", "cert") ?? "(none)"}")
println("missing:   ${config.dig("http", "proxy", "url") ?? "(none)"}")
println("timeout:   ${config.dig("limits", "timeout_ms") ?? 500} ms")

# --- mutation, and the copy that keeps the original intact --------------------

draft = dup(config)
draft["service"] = "booking-canary"
draft.set("owner", "platform").delete("tags")
println("")
println("draft keys:  ${draft.keys.json}")
println("config keys: ${config.keys.json}   — dup kept the original whole (one level deep)")

# --- keys are values, not names ------------------------------------------------

# `->` is the separator a key that is not a string takes; `:` keeps the bare word, so
# `{a -> 1}` and `{a: 1}` are the same dict and a computed key stays `(k): v`.
mixed = {
  1 -> "int key",
  true -> "bool key",
  "1" -> "string key — a different key",
  nil -> "nil key",
}
println("")
println("mixed keys: ${mixed.len} entries, [1] is ${inspect(mixed[1])}, [\"1\"] is ${inspect(mixed["1"])}")
println("written by hand or by index — ${mixed == {}.set(1, "int key").set(true, "bool key").set("1", "string key — a different key").set(nil, "nil key")}")

# --- counting is a dict, and so is a histogram ---------------------------------

println("")
println("headcount by dept: ${staff.map { it["dept"] }.tally.json}")
println("skills in use:     ${staff.flat_map { it["skills"] }.tally.sort_by { (_, n) -> -n }.map { "${it[0]}×${it[1]}" }.join(" ")}")
