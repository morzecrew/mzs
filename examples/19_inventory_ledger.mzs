# 19 — an inventory ledger: movements in, balances and FIFO cost out.
#
#   mzs examples/19_inventory_ledger.mzs
#
# Stock is not a number, it is a history: what came in at what price, what left, and what
# is still on the shelf. This file keeps the movements as the source of truth and derives
# everything else — running balance, FIFO cost of goods sold, valuation and reorder
# alerts — so no two numbers can disagree.

CATALOG = [
  [sku: "SHMP-01", name: "Shampoo 250ml",  reorder_at: 12, pack: 6],
  [sku: "COND-01", name: "Conditioner",    reorder_at: 8,  pack: 6],
  [sku: "OIL-05",  name: "Beard oil",      reorder_at: 10, pack: 4],
  [sku: "WAX-02",  name: "Styling wax",    reorder_at: 6,  pack: 12],
]

# kind: receipt (in, with a unit cost), sale (out), adjust (correction, signed)
movements = [
  [day: 1,  sku: "SHMP-01", kind: "receipt", qty: 24, cost: 210],
  [day: 1,  sku: "COND-01", kind: "receipt", qty: 12, cost: 240],
  [day: 1,  sku: "OIL-05",  kind: "receipt", qty: 20, cost: 380],
  [day: 2,  sku: "SHMP-01", kind: "sale",    qty: 3],
  [day: 3,  sku: "OIL-05",  kind: "sale",    qty: 5],
  [day: 4,  sku: "SHMP-01", kind: "sale",    qty: 6],
  [day: 5,  sku: "WAX-02",  kind: "receipt", qty: 12, cost: 150],
  [day: 6,  sku: "COND-01", kind: "sale",    qty: 5],
  [day: 7,  sku: "SHMP-01", kind: "receipt", qty: 12, cost: 245],
  [day: 8,  sku: "SHMP-01", kind: "sale",    qty: 9],
  [day: 9,  sku: "OIL-05",  kind: "sale",    qty: 7],
  [day: 10, sku: "WAX-02",  kind: "sale",    qty: 4],
  [day: 11, sku: "COND-01", kind: "adjust",  qty: -1, note: "broken bottle"],
  [day: 12, sku: "SHMP-01", kind: "sale",    qty: 5],
  [day: 13, sku: "OIL-05",  kind: "sale",    qty: 4],
  [day: 14, sku: "WAX-02",  kind: "sale",    qty: 6],
]

fn signed(m) { m["kind"] == "receipt" ? m["qty"] : (m["kind"] == "adjust" ? m["qty"] : -m["qty"]) }

# --- running balance per SKU ---------------------------------------------------

balances = [:]
history = movements.map { (m) ->
  balances.set(m["sku"], (balances[m["sku"]] ?? 0) + signed(m))
  m.merge([balance: balances[m["sku"]]])
}

say("ledger (${movements.len} movements over ${movements.last["day"]} days)")
say("${"day".rjust(4)}  ${"sku".ljust(9)}${"kind".ljust(9)}${"qty".rjust(5)}${"balance".rjust(9)}")
say("-" * 40)
history.each { (m) ->
  mark = m["balance"] < 0 ? "  ← negative!" : ""
  say("${m["day"].str.rjust(4)}  ${m["sku"].ljust(9)}${m["kind"].ljust(9)}${("%+d" % signed(m)).rjust(5)}${m["balance"].str.rjust(9)}${mark}")
}

# --- FIFO: the lots are a queue, and a sale drains it from the front ----------

fn fifo(sku) {
  lots = []          # each lot is [qty, cost]
  cogs = 0
  shortfall = 0
  movements.filter { it["sku"] == sku }.each { (m) ->
    if m["kind"] == "receipt" {
      lots.push([qty: m["qty"], cost: m["cost"]])
      next
    }
    want = m["kind"] == "adjust" ? -m["qty"] : m["qty"]
    while want > 0 && !lots.empty {
      lot = lots.first
      take = lot["qty"] < want ? lot["qty"] : want
      cogs += take * lot["cost"]
      lot.set("qty", lot["qty"] - take)
      want -= take
      lots.shift if lot["qty"] == 0
    }
    shortfall += want
  }
  [on_hand: lots.sum { it["qty"] }, value: lots.sum { it["qty"] * it["cost"] }, cogs: cogs, shortfall: shortfall, lots: lots]
}

say("")
say("${"sku".ljust(9)}${"name".ljust(16)}${"on hand".rjust(8)}${"value".rjust(9)}${"COGS".rjust(9)}  status")
say("-" * 62)
report = CATALOG.map { (c) -> c.merge(fifo(c["sku"])) }
report.each { (r) ->
  status = match {
    r["on_hand"] <= 0                  -> "OUT OF STOCK"
    r["on_hand"] <= r["reorder_at"]    -> "reorder ${((r["reorder_at"] * 2 - r["on_hand"]) / r["pack"] + 1) * r["pack"]} units"
    else                               -> "ok"
  }
  say("${r["sku"].ljust(9)}${r["name"].ljust(16)}${r["on_hand"].str.rjust(8)}${(r["value"].str + " ₽").rjust(9)}${(r["cogs"].str + " ₽").rjust(9)}  ${status}")
}

# --- the numbers a manager signs off on ---------------------------------------

say("")
say("stock value    ${report.sum { it["value"] }} ₽ across ${report.sum { it["on_hand"] }} units")
say("cost of sales  ${report.sum { it["cogs"] }} ₽")
say("to reorder     ${report.filter { it["on_hand"] <= it["reorder_at"] }.map { it["sku"] }.json}")

# --- movement profile per SKU --------------------------------------------------

say("")
say("movement profile (▲ in, ▼ out)")
CATALOG.each { (c) ->
  ms = movements.filter { it["sku"] == c["sku"] }
  bar = ms.map { (m) -> signed(m) > 0 ? "▲" : "▼" }.join("")
  say("  ${c["sku"].ljust(9)}${bar.ljust(10)} ${ms.len} movements, last on day ${ms.last["day"]}")
}

# --- turnover, and the item nobody buys ---------------------------------------

sold = movements.filter { it["kind"] == "sale" }.group_by { it["sku"] }
say("")
say("turnover")
CATALOG.sort_by { (c) -> -(sold[c["sku"]] ?? []).sum { it["qty"] } }.each { (c) ->
  units = (sold[c["sku"]] ?? []).sum { it["qty"] }
  days = movements.last["day"]
  per_week = units * 7 * 10 / days
  say("  ${c["name"].ljust(16)}${units.str.rjust(3)} sold  ≈ ${per_week / 10}.${per_week % 10}/week")
}

# --- a consistency check the ledger can run on itself -------------------------

recomputed = CATALOG.map { (c) ->
  [sku: c["sku"], from_movements: movements.filter { it["sku"] == c["sku"] }.sum { signed(it) }, from_fifo: fifo(c["sku"])["on_hand"]]
}
say("")
say("balances agree with the FIFO lots: ${recomputed.all { it["from_movements"] == it["from_fifo"] }}")
say("  ${recomputed.map { "${it["sku"]}=${it["from_movements"]}" }.join("  ")}")
