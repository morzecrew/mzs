# 16 — an intent router: the job this language was written for.
#
#   mzs examples/16_intent_router.mzs
#   mzs -v '__sent=I want to book for tomorrow at 14:00' examples/16_intent_router.mzs
#
# A bot receives a line of text and has to decide what it means, pull the details out of
# it, and answer. That is one normalisation, a table of scored rules, a few captures and
# a reply — and it has to survive an empty message, a message in the wrong case and a
# message that is nothing but an emoji.

# --- rules: a name, a weight, and a test that is a closure --------------------

RULES = [
  {intent: "greeting",  weight: 2, test: { (s) -> s ~ /^(hi|hello|hey|good (morning|afternoon|evening))\b/ }},
  {intent: "booking",   weight: 5, test: { (s) -> s ~ /book|appointment|reserve|sign me up/ }},
  {intent: "booking",   weight: 3, test: { (s) -> s ~ /\b(on|for) (today|tomorrow|mon|tue|wed|thu|fri|sat|sun)\w*\b/ }},
  {intent: "cancel",    weight: 6, test: { (s) -> s ~ /cancel|call it off|not coming|reschedule/ }},
  {intent: "price",     weight: 4, test: { (s) -> s ~ /how much|price|pricing|cost|rates/ }},
  {intent: "hours",     weight: 4, test: { (s) -> s ~ /what time|opening hours|when.{0,12}open|\bhours\b/ }},
  {intent: "handoff",   weight: 8, test: { (s) -> s ~ /operator|real person|human being|manager|complaint/ }},
  {intent: "thanks",    weight: 2, test: { (s) -> s ~ /thanks|thank you|cheers|appreciate/ }},
  {intent: "confirm",   weight: 3, test: { (s) -> s ~ /^(yes|yeah|sure|ok|confirm)\b/ }},
  {intent: "decline",   weight: 3, test: { (s) -> s ~ /^(no|nope|not now)\b/ }},
]

# --- entities: what the message says, not just what it means ------------------

fn entities(s) {
  found = {}
  time = s.captures(/\b(\d{1,2})[:.](\d{2})\b/)
  found.set("time", "${time[1].rjust(2, "0")}:${time[2]}") if time != nil
  day = s.captures(/\b(today|tomorrow|monday|tuesday|wednesday|thursday|friday|saturday|sunday)\b/)
  found.set("day", day[1]) if day != nil
  people = s.captures(/\bfor (\d+) (?:person|people|guests)/)
  found.set("people", people[1].int) if people != nil
  phone = s.captures(/(\+?\d[\d\s()-]{9,})/)
  found.set("phone", phone[1].replace(/\D/, "")) if phone != nil
  # `\w` is ASCII by design (RE2 semantics); `\p{L}` is the Unicode letter class, so a
  # service name in any script — and any suffix — still matches.
  service = s.captures(/(haircut\p{L}*|beard\p{L}*|colour\p{L}*|coloring\p{L}*|manicure\p{L}*)/)
  found.set("service", service[1]) if service != nil
  found
}

# --- the router ----------------------------------------------------------------

fn route(raw) {
  s = raw.lower.trim.squeeze(" ")
  return {intent: "empty", score: 0, confidence: 0.0, entities: {}, normalized: s} if s.blank

  hits = RULES.filter { it["test"].call(s) }
  scores = hits.reduce({}) { (acc, r) -> acc.set(r["intent"], (acc[r["intent"]] ?? 0) + r["weight"]) }
  best = scores.sort_by { (_, w) -> -w }.first
  total = scores.values.sum

  { intent:     best == nil ? "unknown" : best[0],
    score:      best == nil ? 0 : best[1],
    confidence: best == nil ? 0.0 : (best[1] * 100 / total).float / 100,
    competing:  scores.len > 1 ? scores.keys.reject { it == best[0] } : [],
    entities:   entities(s),
    normalized: s }
}

# --- replies: one place, so the wording is reviewable -------------------------

REPLIES = {
  greeting: "Hello! How can I help — book you in, quote a price or show our hours?",
  booking:  "Booking you in. Tell me the service and the time if you have not yet.",
  cancel:   "Appointment cancelled. Would you like another time?",
  price:    "Haircut — 1500, beard — 800, colour — from 3200.",
  hours:    "We are open every day from 10:00 to 21:00.",
  handoff:  "Putting you through to an operator, one moment.",
  thanks:   "Any time!",
  confirm:  "Noted.",
  decline:  "Understood, nothing changed.",
  empty:    "Send me a message and I will help.",
  unknown:  "I did not get that. I can book you in, quote a price or show our hours.",
}

fn keyboard(intent) {
  match intent {
    "booking" -> [["Today", "book:today"], ["Tomorrow", "book:tomorrow"], ["Another day", "book:pick"]]
    "price"   -> [["Full price list", "price:all"], ["Book now", "book:start"]]
    "unknown" -> [["Menu", "menu"], ["Operator", "handoff"]]
    else      -> []
  }
}

fn answer(raw) {
  r = route(raw)
  buttons = keyboard(r["intent"]).map { (b) -> {text: b[0], data: b[1]} }
  r.merge({reply: REPLIES[r["intent"]], keyboard: buttons})
}

# --- a batch, so the table shows the routing at a glance ----------------------

messages = [
  $__sent ?? "Hi! I would like to book a haircut for tomorrow at 14:00",
  "HOW MUCH does a colour cost?",
  "  what time do you open  ",
  "please cancel my appointment",
  "give me an operator, I have a complaint",
  "yes",
  "thanks!!!",
  "book a table for 4 people, phone +7 999 123-45-67",
  "🙂",
  "",
]

println("${"message".ljust(42)}${"intent".ljust(10)}${"conf".rjust(5)}  entities")
println("-" * 92)
messages.each { (m) ->
  r = route(m)
  ent = r["entities"].empty ? "" : r["entities"].json
  println("${(m.len > 40 ? m.first(39) + "…" : m).ljust(42)}${r["intent"].ljust(10)}${("%.2f" % r["confidence"]).rjust(5)}  ${ent}")
}

# --- one message, fully answered ----------------------------------------------

full = answer(messages.first)
println("")
println("full answer for ${inspect(messages.first)}")
println("  normalized: ${inspect(full["normalized"])}")
println("  intent:     ${full["intent"]} (score ${full["score"]}, confidence ${"%.0f%%" % (full["confidence"] * 100)})")
println("  competing:  ${full["competing"].empty ? "none" : full["competing"].join(", ")}")
println("  entities:   ${full["entities"].json}")
println("  reply:      ${full["reply"]}")
println("  keyboard:   ${full["keyboard"].json}")

# --- what the host actually stores back ---------------------------------------

$intent = full["intent"]
$slot_day = full["entities"]["day"] ?? ""
$slot_time = full["entities"]["time"] ?? ""
$needs_operator = full["intent"] == "handoff"

println("")
println("host variables: ${{intent: $intent, day: $slot_day, time: $slot_time, operator: $needs_operator}.json}")

# The value of the program is the branch a flow engine takes next.
$intent
