# 12 — CSV in, report out, including the quoting nobody enjoys.
#
#   mzs examples/12_csv_report.mzs
#
# `split(",")` is not a CSV parser: it breaks on the first quoted comma, on a doubled
# quote and on a line break inside quotes. `include csv` is (§12.19): it reads RFC 4180
# into records, and this file treats them as data — typed, filtered, grouped, totalled
# and written back out with the quotes restored.

include csv

data = 'id,customer,city,item,qty,unit_price,paid
1001,"Petrov, Ivan",Moscow,haircut,2,1500,yes
1002,Anna Smith,Berlin,"colour, full",1,3200,yes
1003,"O\'Brien, Sean",Dublin,beard,3,800,no
1004,Li Ming,Shanghai,haircut,1,1500,yes
1005,"Müller, Jan",Berlin,"care ""deluxe""",2,2400,no
1006,Anna Smith,Berlin,shave,4,600,yes
1007,Ivan Petrov,Moscow,colour,1,3200,yes
1008,Li Ming,Shanghai,"beard, hot towel",2,1100,yes'

# --- reading: one call, and every field is a string --------------------------
#
# Before the module this file carried its own scanner — an `in_quotes` flag, and a
# lookahead for the doubled quote — and still could not read a field with a line break
# in it. `{header: true}` makes every record a dict in the header's order.

rows = csv.parse(data, {header: true})
header = rows.first.keys

println("columns: ${header.json}")
println("rows:    ${rows.len}")

# --- typing: a CSV field is a string until the program says otherwise ---------

orders = rows.map { (r) ->
  { id:    r["id"].int,
    who:   r["customer"],
    city:  r["city"],
    item:  r["item"],
    qty:   r["qty"].int,
    price: r["unit_price"].int,
    paid:  r["paid"] == "yes",
    total: r["qty"].int * r["unit_price"].int }
}

println("")
println("quoting survived the round trip:")
orders.take(3).each { (o) -> println("  ${o["id"]}  ${inspect(o["who"]).ljust(20)}${inspect(o["item"])}") }
println("  a doubled quote inside a field: ${inspect(orders.find { it["id"] == 1005 }["item"])}")

# --- the report ----------------------------------------------------------------

fn money(n) { "${n} ₽" }

println("")
println("${"city".ljust(10)}${"orders".rjust(7)}${"units".rjust(7)}${"revenue".rjust(10)}${"unpaid".rjust(10)}")
println("-" * 44)
orders.group_by { it["city"] }
      .sort_by { (_, os) -> -os.sum { it["total"] } }
      .each { (pair) ->
        city = pair[0]
        os = pair[1]
        unpaid = os.reject { it["paid"] }.sum { it["total"] }
        println("${city.ljust(10)}${os.len.str.rjust(7)}${os.sum { it["qty"] }.str.rjust(7)}${money(os.sum { it["total"] }).rjust(10)}${(unpaid == 0 ? "—" : money(unpaid)).rjust(10)}")
      }
println("-" * 44)
println("${"total".ljust(10)}${orders.len.str.rjust(7)}${orders.sum { it["qty"] }.str.rjust(7)}${money(orders.sum { it["total"] }).rjust(10)}${money(orders.reject { it["paid"] }.sum { it["total"] }).rjust(10)}")

# --- the questions a spreadsheet is opened for --------------------------------

println("")
println("best customer:   ${orders.group_by { it["who"] }.map { (who, os) -> {who: who, sum: os.sum { it["total"] }} }.max_by { it["sum"] }.pipe { "${it["who"]} (${money(it["sum"])})" }}")
println("most sold item:  ${orders.group_by { it["item"] }.map { (i, os) -> {item: i, qty: os.sum { it["qty"] }} }.max_by { it["qty"] }.pipe { "${it["item"]} × ${it["qty"]}" }}")
println("average ticket:  ${money(orders.sum { it["total"] } / orders.len)}")
println("unpaid orders:   ${orders.reject { it["paid"] }.map { it["id"] }.json}")
println("cities:          ${orders.map { it["city"] }.uniq.sort.join(", ")}")

# --- writing CSV back out: quote only what needs quoting ----------------------
#
# csv.str writes a header from the first row's keys and quotes a field only when it has
# to: a comma, a quote (doubled), a line break, a space at either end.

fn columns(records, keys) { records.map { (r) -> keys.map { [it, r[it]] }.dict } }

println("")
println("unpaid orders, written back as CSV:")
print(csv.str(columns(orders.reject { it["paid"] }, ["id", "who", "item", "total"])))

# --- a sanity check the program can make about itself -------------------------

reparsed = csv.parse(csv.str(columns(orders, ["id", "who", "item"])), {header: true})
println("")
println("round trip preserves every field: ${reparsed.map { it["who"] } == orders.map { it["who"] }}")
