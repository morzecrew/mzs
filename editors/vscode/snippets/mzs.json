{
  "include a built-in module": {
    "prefix": "inc",
    "body": "include ${1|json,math,time,date,http,io,decimal,crypto,url|}",
    "description": "Include a built-in module (§12.8)"
  },
  "include a script module": {
    "prefix": "incfrom",
    "body": "include ${1:lib} from \"./${2:lib}.mzs\"",
    "description": "Include a neighbouring .mzs"
  },
  "exact money": {
    "prefix": "dec",
    "body": [
      "include decimal",
      "",
      "${1:price} = decimal.of(\"${2:1500.35}\")",
      "decimal.str(${1:price}, ${3:2})"
    ],
    "description": "An exact decimal, and the string it prints as (§12.15)"
  },
  "check a webhook signature": {
    "prefix": "hmac",
    "body": [
      "include crypto",
      "",
      "${1:signed} = crypto.hmac(${2:SECRET}, ${3:body})",
      "crypto.equal(${1:signed}, ${4:header})"
    ],
    "description": "Sign a body and compare in constant time (\u00a712.16)"
  },
  "build a URL": {
    "prefix": "url",
    "body": [
      "include url",
      "",
      "url.build({scheme: \"https\", host: \"${1:api.example.com}\", path: \"${2:/v1/orders}\",",
      "           query: {${3:page}: ${4:2}}})"
    ],
    "description": "Assemble a URL out of its parts (\u00a712.17)"
  },
  "export a function": {
    "prefix": "expfn",
    "body": [
      "export fn ${1:name}(${2:args}) {",
      "\t$0",
      "}"
    ],
    "description": "A function the module exports"
  },
  "export a value": {
    "prefix": "exp",
    "body": "export ${1:name} = ${2:value}",
    "description": "A value the module exports"
  },
  "record": {
    "prefix": "record",
    "body": "record ${1:Money}(${2:amount}, ${3:currency} = ${4:\"RUB\"})",
    "description": "Declare a record: a name for a shape over a dict (§7.8)"
  },
  "export a record": {
    "prefix": "exrec",
    "body": "export record ${1:Money}(${2:amount}, ${3:currency})",
    "description": "Export a record from a module (§7.8, §12.8)"
  },
  "match on a record": {
    "prefix": "matchrec",
    "body": "match ${1:x} {\n  ${2:Money} -> ${3:\"money\"}\n  else  -> ${4:\"other\"}\n}",
    "description": "Dispatch on a record's shape (§5.3, §7.8)"
  },
  "function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:args}) {",
      "\t$0",
      "}"
    ],
    "description": "A function declaration"
  },
  "async function": {
    "prefix": "async",
    "body": [
      "async fn ${1:name}(${2:args}) {",
      "\t$0",
      "}"
    ],
    "description": "An async function declaration: calling it starts a task (§8.14)"
  },
  "await a task": {
    "prefix": "await",
    "body": [
      "${1:task}.await"
    ],
    "description": "Await a task and take its value"
  },
  "function one-line": {
    "prefix": "fn1",
    "body": "fn ${1:name}(${2:args}) { $0 }",
    "description": "A one-line function"
  },
  "closure": {
    "prefix": "cl",
    "body": "{ (${1:x}) -> $0 }",
    "description": "A closure with parameters"
  },
  "heredoc": {
    "prefix": "heredoc",
    "body": "<<~${1:TEXT}\n  $0\n${1:TEXT}",
    "description": "A heredoc: the lines below, with the common indent shed (§3.7)"
  },
  "heredoc raw": {
    "prefix": "heredocraw",
    "body": "<<~'${1:TEXT}'\n  $0\n${1:TEXT}",
    "description": "A raw heredoc: no escapes and no interpolation (§3.7)"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if ${1:cond} {",
      "\t$0",
      "}"
    ],
    "description": "A conditional"
  },
  "if else": {
    "prefix": "ife",
    "body": [
      "if ${1:cond} {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "A conditional with an else"
  },
  "match": {
    "prefix": "match",
    "body": [
      "match ${1:x} {",
      "\tin [${2:\"yes\", \"yeah\"}] -> $3",
      "\telse -> $0",
      "}"
    ],
    "description": "Dispatch by case instead of an if ladder"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while ${1:cond} {",
      "\t$0",
      "}"
    ],
    "description": "A loop"
  },
  "for in": {
    "prefix": "for",
    "body": [
      "for ${1:x} in ${2:xs} {",
      "\t$0",
      "}"
    ],
    "description": "A loop over a collection"
  },
  "try else": {
    "prefix": "try",
    "body": "try ${1:expr} else ${0:\"a fallback value\"}",
    "description": "Catch an error from an expression"
  },
  "try block": {
    "prefix": "tryb",
    "body": [
      "try {",
      "\t${1:body}",
      "} else (e) {",
      "\t$0",
      "}"
    ],
    "description": "Catch an error from a block, binding the error dict"
  },
  "try ensure": {
    "prefix": "ensure",
    "body": [
      "try {",
      "\t${1:body}",
      "} ensure {",
      "\t$0",
      "}"
    ],
    "description": "Release on every way out of the block that leaves the Run alive"
  },
  "ternary": {
    "prefix": "?:",
    "body": "${1:cond} ? ${2:a} : ${3:b}",
    "description": "The ternary operator"
  },
  "map block": {
    "prefix": "map",
    "body": "${1:xs}.map { ${2:it} }",
    "description": "map with a closure"
  },
  "filter block": {
    "prefix": "filter",
    "body": "${1:xs}.filter { ${2:it} > 0 }",
    "description": "filter with a closure"
  },
  "each block": {
    "prefix": "each",
    "body": "${1:xs}.each { (${2:x}) -> $0 }",
    "description": "each with a closure"
  },
  "reduce": {
    "prefix": "reduce",
    "body": "${1:xs}.reduce(${2:0}) { (${3:acc}, ${4:x}) -> $0 }",
    "description": "A fold"
  },
  "web server": {
    "prefix": "serve",
    "body": [
      "include http",
      "",
      "http.serve(\"${1::8080}\", {",
      "  \"GET /${2:hello}\": { (req) -> http.json({${3:message}: \"$4\"}) },",
      "})"
    ],
    "description": "A web server: a route and a JSON reply"
  },
  "condition equals": {
    "prefix": "cond=",
    "body": "$${1:__sent}.lower.trim == \"${2:yes}\"",
    "description": "A morzebot condition: normalise and compare"
  },
  "condition regex": {
    "prefix": "cond~",
    "body": "$${1:__sent} ~ /${2:hello}/i",
    "description": "A morzebot condition: a regex"
  },
  "condition router": {
    "prefix": "cond?",
    "body": "match $${1:__sent}.lower.trim { in [\"yes\", \"yeah\"] -> 1; /^no/ -> 0; else -> nil }",
    "description": "A morzebot condition: an intent router"
  }
}
