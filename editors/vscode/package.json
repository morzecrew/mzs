{
  "name": "mzs",
  "displayName": "mzs",
  "description": "Syntax highlighting, completion, hovers and diagnostics for the mzs language",
  "version": "1.1.0",
  "publisher": "morze",
  "license": "MIT",
  "icon": "icons/logo-128.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Themes"
  ],
  "keywords": [
    "mzs",
    "morze",
    "morzebot",
    "ruby"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:mzs"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mzs",
        "aliases": [
          "mzs",
          "Morze Script"
        ],
        "extensions": [
          ".mzs"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/mzs-light.svg",
          "dark": "./icons/mzs-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "mzs",
        "scopeName": "source.mzs",
        "path": "./syntaxes/mzs.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "mzs-seti",
        "label": "mzs (Seti)",
        "path": "./icons/theme/mzs-seti-icon-theme.json"
      }
    ],
    "snippets": [
      {
        "language": "mzs",
        "path": "./snippets/mzs.json"
      }
    ],
    "commands": [
      {
        "command": "mzs.runFile",
        "title": "mzs: Run file",
        "icon": "$(play)"
      },
      {
        "command": "mzs.evalSelection",
        "title": "mzs: Evaluate selection as a one-liner"
      },
      {
        "command": "mzs.showTokens",
        "title": "mzs: Show the token stream"
      },
      {
        "command": "mzs.showAst",
        "title": "mzs: Show the AST"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "mzs.runFile",
          "when": "resourceLangId == mzs",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "mzs.evalSelection",
          "when": "resourceLangId == mzs && editorHasSelection",
          "group": "z_commands"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mzs.evalSelection",
        "key": "ctrl+shift+e",
        "when": "editorTextFocus && resourceLangId == mzs && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "mzs",
      "properties": {
        "mzs.path": {
          "type": "string",
          "default": "mzs",
          "markdownDescription": "Path to the `mzs` executable. Build it with `go build -o ~/bin/mzs ./cmd/mzs`."
        },
        "mzs.time": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Check and run with `--time` — without it `include time` and `include date` are an error (SPEC §12.8)."
        },
        "mzs.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show the errors and warnings from `mzs --check`."
        },
        "mzs.diagnostics.delay": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "Delay in milliseconds between typing and checking."
        },
        "mzs.completion.enable": {
          "type": "boolean",
          "default": true,
          "description": "Complete methods, built-in functions and keywords."
        }
      }
    }
  }
}
